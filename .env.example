# Copy this file to ".env" (same folder as app.py) and fill in whichever
# key(s) you have, then restart the app (python app.py). No other setup
# needed — the AI Assistant and AI Quiz Generator will automatically start
# using real AI instead of the built-in offline engine.
#
# You only need ONE of these. If both are set, Gemini is tried first.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Optional, only if you want to change from the defaults ---
# GEMINI_MODEL=gemini-2.0-flash
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Deployment only (set these in Render's Environment tab, not in a file) ---
# SECRET_KEY=a-long-random-string
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=choose-a-strong-password
